# Every setting below has its full "why" (safe defaults, prod risk warnings,
# anti-OOM tuning, etc.) documented as a comment in backend/config.py — this
# file just lists the keys with a one-line pointer so ops don't have to read
# the source to discover them. Commented-out keys use the config.py default;
# uncomment and set a value to override it.

# ============ LLMs ============
GROQ_API_KEY=
GEMINI_API_KEY=
# Free-tier safety net: kicks in when Groq/Gemini's free quota is exhausted.
# Free key (email signup, no phone): openrouter.ai/keys — see config.py
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Free-tier rate-limit pacing (requests/min) so a video's LLM burst doesn't
# trip a 429 — see config.py
# GROQ_RPM=25
# GEMINI_RPM=10
# How many times a job errored by an LLM outage is resurrected — see config.py
# LLM_RETRY_MAX=12
# Ground factual topics (sports/news) in real web sources via Gemini + Google
# Search before scripting. Needs GEMINI_API_KEY — see config.py
# RESEARCH_ENABLED=true

# ============ Visual / B-roll ============
# AI images: provide AT LEAST ONE of POLLINATIONS_TOKEN or HUGGINGFACE_TOKEN
# (both free). Without any key, the system falls back to local placeholder
# frames so the pipeline still runs. Pexels/Pixabay give real stock photos/video.
POLLINATIONS_TOKEN=
HUGGINGFACE_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Prefer real licensed stock VIDEO over AI stills when a clip matches a scene
# — see config.py
# BROLL_ENABLED=true
# BROLL_MAX_WIDTH=1920
# VISUALS_CONCURRENCY=4

# ============ Premium TTS (LMNT voice clone) ============
# Set BOTH keys to switch narration from edge-tts to your LMNT voice clone;
# blank = keep edge-tts. Voice id from the Voices tab in app.lmnt.com — see config.py
# LMNT_API_KEY=
# LMNT_VOICE=
# TTS_PROVIDER=auto
# TTS_RATE=+8%

# ============ YouTube ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/drive-library/auth/callback
# GOOGLE_DRIVE_API_KEY=

# ============ TikTok (fill after Content Posting API approval) ============
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback
# While true, forces every TikTok post to SELF_ONLY (private) because an
# unaudited app can't post publicly. Set 0 after production approval — see config.py
# TIKTOK_SANDBOX=true

# ============ Instagram / Meta ============
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/auth/instagram/callback

# ============ App ============
# Public base URL of this deploy (e.g. https://your-app.up.railway.app). When
# set, redirect URIs above default to this host — see config.py
# APP_BASE_URL=
SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=sqlite:///./studio.db
REDIS_URL=redis://localhost:6379
TEMP_DIR=./tmp
OUTPUT_DIR=./output
CACHE_DIR=./cache
ASSETS_DIR=./assets
MAX_QUEUE_SIZE=500
# Only set true if a real Celery worker is also deployed; otherwise the
# pipeline runs in-process — see config.py
# USE_CELERY=false
# Hands-off mode: scheduled videos are generated AND published without
# waiting for human approval — see config.py
# AUTO_PUBLISH=false
# "Momento em alta" (trending) safety knobs — see config.py
# TRENDING_ENABLED=true
# MAX_TRENDING_PER_DAY=4
# TRENDING_FRESHNESS_TTL_H=12
# ffmpeg/render tuning to avoid OOM-killing a small container — see config.py
# FFMPEG_THREADS=2
# VIDEO_RESOLUTION=720
# VIDEO_TRANSITIONS=false
# Kill-switch for the Drive-sourced "ready video" editorial curation layer
# (adds an original take so reused footage isn't desmonetized) — see config.py
# READY_VIDEO_CURATION_ENABLED=true
# Visibility for auto-published videos when the job doesn't specify one
# (private|unlisted|public) — see config.py
# DEFAULT_PRIVACY=private
# "schedule" (generate ahead, YouTube publishes at slot time) or "immediate"
# (generate and publish right at the slot) — see config.py
# PUBLISH_MODE=schedule
# False rejects a hollow LLM-less script instead of publishing it — see config.py
# ALLOW_OFFLINE_SCRIPT=false
# GENERATION_LEAD_MINUTES=30
DEFAULT_TTS_VOICE=pt-BR-AntonioNeural
DEFAULT_LANGUAGE=pt-BR
LOG_LEVEL=INFO
# MAX_MANUAL_UPLOAD_MB=500
# MAX_VOICE_CLONE_UPLOAD_MB=25
# CTA (affiliate/product/newsletter links + FTC disclosure) injected at the
# top of every YouTube description. Empty = disabled — see config.py
# MONETIZATION_CTA=
# Extra languages to localize each video's title/description into, comma-
# separated ISO codes (e.g. en,es,hi). Empty = disabled — see config.py
# LOCALIZE_LANGUAGES=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ Railway (set in the Railway dashboard) ============
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
